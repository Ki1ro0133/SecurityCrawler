{
  "name": "securitycrawler",
  "version": "1.0.0",
  "description": "可扩展的多站点安全文章采集应用",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "web": "node server.js",
    "images-only": "node index.js --site=xianzhi --images-only",
    "range-2025Q3": "node index.js --site=xianzhi --start-date=2025-07-01 --end-date=2025-09-30 --max-pages=10",
    "after-2024": "node index.js --site=xianzhi --target-date=2024-01-01 --max-pages=5",
    "install-browsers": "npx playwright install"
  },
  "dependencies": {
    "jsdom": "^27.0.0",
    "playwright": "^1.40.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.5"
  },
  "keywords": [
    "security",
    "crawler",
    "playwright",
    "plugin"
  ],
  "author": "",
  "license": "MIT"
}
